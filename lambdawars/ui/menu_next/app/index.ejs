<!doctype html>
<html class="no-js">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <title ng-bind="pageTitle"></title>
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width">
</head>

<body ng-controller="AppController as app">
    <div id="bg-overlay"></div>

    <header id="top-bar" class="noselect" ng-controller="MainButtonsController">
        <a href="#!/" id="menu-logo">
            <img src="images/lw-logo.png" />
        </a>

        <ul id="main-menu" class="menu">
            <li ng-if="!ingame && steam_available">
                <a href="#!/Multiplayer" class="menu-btn" id="menu-multiplayer" ng-class="{active: isSection('online')}" translate="MenuOnline"></a>
            </li>
            <li ng-if="ingame && steam_available">
                <a href="#!/InGame" class="menu-btn" id="menu-ingame" ng-class="{active: isSection('ingame')}" translate="MenuInGame"></a>
            </li>
            <li ng-if="!ingame && steam_available">
                <a href="#!/Singleplayer" class="menu-btn" id="menu-singleplayer" ng-class="{active: isSection('offline')}" translate="MenuOffline"></a>
            </li>
            <!-- Visual only for now, the Workshop pages are added with the Workshop integration -->
            <li ng-if="workshopEnabled && !ingame && steam_available">
                <a class="menu-btn" id="menu-workshop" translate="MenuWorkshop"></a>
            </li>
            <li>
                <a href="#!/Settings" class="menu-btn" id="menu-settings" ng-class="{active: isSection('settings')}" translate="MenuSettings"></a>
            </li>
        </ul>

        <div id="top-bar-right">
            <button type="button" id="menu-chat" class="lb-btn lb-btn-small" ng-if="chatdrawer.available() && steam_available"
                ng-class="{active: chatdrawer.open}" ng-click="chatdrawer.toggle()" aria-expanded="{{ chatdrawer.open }}">
                <wars-icon name="chat"></wars-icon>{{ 'Menu_Chat' | translate }}
                <span class="menu-chat-online">{{ numcurplayers }} {{ 'Menu_StatusOnline' | translate }}</span>
            </button>
            <span class="top-bar-divider" ng-if="chatdrawer.available() && steam_available"></span>

            <div ng-controller="SwarmKeeperBonusController" ng-if="steam_available">
                <img id="swarm_keeper_bonus" ng-show="showSwarmBonus" alt="swarm_keeper_bonus"
                    ng-init="bg = '../../mainmenu/swarm_keeper_bonus_but.png'"
                    ng-mouseenter="bg = '../../mainmenu/swarm_keeper_bonus_but_over.png'"
                    ng-mouseleave="bg = '../../mainmenu/swarm_keeper_bonus_but.png'" ng-src="{{bg}}"
                    ng-click="launchSwarmKeeperBonus()" ng-tooltip="{{ 'MenuBonusSwarmKeeper_Tooltip' | translate }}" />
            </div>

            <a href="#!/Profile" id="player-info" ng-controller="PlayerInfoController">
                <span class="player-text" ng-tooltip="{{ 'Menu_TooltipOpenProfile' | translate }} {{ playername }}">
                    <span class="player-name">{{ playername }}</span>
                    <span class="player-status" ng-class="{offline: !steam_available}">{{ (steam_available ? 'Menu_StatusOnline' : 'Menu_StatusOffline') | translate }}</span>
                </span>
                <img class="player-avatar" ng-src="{{ avatarsrc }}" />
            </a>

            <span class="top-bar-divider"></span>

            <a href id="menu-quit" ng-click="quit()" ng-tooltip="{{ 'MenuQuit' | translate }}">
                <wars-icon name="power"></wars-icon>
            </a>
        </div>

        <div ng-if="beta === 'dev'" id="dev-text"><b>Developers Build {{ devrevision }}</b></div>
    </header>

    <div class="content-all" id="{{ pageID }}" ng-class="pageClass" ng-view></div>

    <!-- Global chat drawer, for pages without a chat of their own -->
    <div ng-controller="ChatDrawerController">
    <aside id="chat-drawer" ng-if="drawer.open && drawer.available()" aria-label="{{ 'Chat_Global' | translate }}">
        <div class="chat-drawer-header">
            <h2>{{ 'Chat_Global' | translate }}</h2>
            <span class="chat-drawer-online">{{ numcurplayers }} {{ 'Menu_StatusOnline' | translate }}</span>
            <button type="button" class="lb-icon-btn" ng-click="drawer.close()" aria-label="{{ 'Dialog_Cancel' | translate }}"><wars-icon name="close"></wars-icon></button>
        </div>
        <div class="lb-chat-pane">
            <chat-lines ng-controller="LobbyChatHistoryController as chatCtrl" chat-service="chatlobby"></chat-lines>
            <div class="lb-chat-controls" ng-controller="LobbySendChatController" chat-service="chatlobby">
                <form ng-submit="sendChat()" class="lb-chat-form"><input type="text" ng-model="text" placeholder="{{ 'GL_ChatPlaceholderGlobal' | translate }}" /></form>
                <span class="lb-chat-language" ng-if="inputlanguage">{{ inputlanguage }}</span>
                <a href class="lb-chat-send" ng-click="sendChat()">{{ 'Chat_Send' | translate }}</a>
            </div>
        </div>
    </aside>
    </div>
</body>

</html>